. program define fit
  1.     syntax, MODEL(name) Y(name) RHS(string) TARGET(name) FLAG(name) RESULT
> S(name) COEFFICIENTS(name)
  2.     quietly count if `flag'
  3.     local expected = r(N)
  4.     display "ROUND3 `model' `y' `rhs'"
  5.     regress `y' `rhs' if `flag', vce(cluster source_id)
  6.     assert e(N) == `expected'
  7.     assert e(N) >= 40 & e(N_clust) >= 20
  8.     assert _se[`target'] > 0 & _se[`target'] < .
  9.     generate byte used_`model' = e(sample)
 10.     local critical = invttail(e(df_r), .025)
 11.     local b = _b[`target']
 12.     local se = _se[`target']
 13.     local pv = 2*ttail(e(df_r),abs(`b'/`se'))
 14.     post `results' ("`model'") ("`y'") ("`target'") (`b') (`se') (`pv') (`
> b'-`critical'*`se') (`b'+`critical'*`se') (e(N)) (e(N_clust)) (e(r2))
 15.     local terms : colnames e(b)
 16.     foreach term of local terms {
 17.         local b = _b[`term']
 18.         local se = _se[`term']
 19.         local pv = cond(`se'>0,2*ttail(e(df_r),abs(`b'/`se')),.)
 20.         post `coefficients' ("`model'") ("`term'") (`b') (`se') (`pv') (`b
> '-`critical'*`se') (`b'+`critical'*`se')
 21.     }
 22. end

. 
. import delimited using "`data'", clear varnames(1) encoding(UTF-8) asdouble
(28 vars, 613 obs)

. isid obs_id

. isid unit_id

. generate byte patent_common = patent_m1 & choice_match

. generate byte patent_at_entry = patent_m1 & choice_visible_by_entry

. generate byte follow = entry_rows > 0

. generate byte follow_noapr = entry_rows_noapr > 0

. generate byte follow_debt = follow & !missing(debt)

. quietly summarize debt if follow_debt, meanonly

. local debt_mean = r(mean)

. display "Debt mean in Q3 common sample = " %15.9f `debt_mean'
Debt mean in Q3 common sample =     6.408304585

. generate double debt_c = debt - `debt_mean' if follow_debt
(225 missing values generated)

. generate double p_debt = p*debt_c if follow_debt
(225 missing values generated)

