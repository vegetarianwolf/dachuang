. global trial_results `results'

. global trial_coefficients `coefficients'

. global trial_margins `margins'

. 
. capture program drop trial

. program define trial
  1.     syntax, scope(string) model(string) outcome(name) rhs(string) target(s
> tring) flag(name) [weight(name) margin(integer 0)]
  2.     tempvar eligible tag used
  3.     gen byte `eligible' = sample == "`scope'" & `flag' == 1
  4.     quietly count if `eligible'
  5.     local n = r(N)
  6.     quietly egen `tag' = tag(city_id) if `eligible'
  7.     quietly count if `tag' == 1
  8.     local clusters = r(N)
  9.     if `n' < 40 | `clusters' < 20 {
 10.         post $trial_results ("`scope'") ("`model'") ("`outcome'") ("`targe
> t'") ("insufficient_sample") (.) (.) (.) (.) (.) (`n') (`clusters') (.) (.) (
> .)
 11.         exit
 12.     }
 13.     local w ""
 14.     if "`weight'" != "" local w "[aw=`weight']"
 15.     noisily display "TRIAL `scope' `model': `outcome' `rhs'"
 16.     if "`weight'" == "" {
 17.         capture noisily xtreg `outcome' `rhs' i.year if `eligible', fe vce
> (cluster city_id)
 18.     }
 19.     else {
 20.         capture noisily areg `outcome' `rhs' i.year if `eligible' `w', abs
> orb(panel_id) vce(cluster city_id)
 21.     }
 22.     local rc = _rc
 23.     if `rc' != 0 {
 24.         post $trial_results ("`scope'") ("`model'") ("`outcome'") ("`targe
> t'") ("stata_error_`rc'") (.) (.) (.) (.) (.) (`n') (`clusters') (.) (.) (.)
 25.         exit
 26.     }
 27.     gen byte `used' = e(sample)
 28.     quietly summarize year if `used', meanonly
 29.     local ymin = r(min)
 30.     local ymax = r(max)
 31.     local critical = invttail(e(df_r), .025)
 32.     local b = _b[`target']
 33.     local se = _se[`target']
 34.     local p = cond(`se' > 0, 2*ttail(e(df_r), abs(`b'/`se')), .)
 35.     local status "ok"
 36.     if `se' == 0 local status "target_omitted"
 37.     local r2w = .
 38.     if "`weight'" == "" local r2w = e(r2_w)
 39.     post $trial_results ("`scope'") ("`model'") ("`outcome'") ("`target'")
>  ("`status'") (`b') (`se') (`p') (`b'-`critical'*`se') (`b'+`critical'*`se') 
> (e(N)) (`clusters') (`ymin') (`ymax') (`r2w')
 40.     local terms : colnames e(b)
 41.     foreach term of local terms {
 42.         local b = _b[`term']
 43.         local se = _se[`term']
 44.         local p = cond(`se' > 0, 2*ttail(e(df_r), abs(`b'/`se')), .)
 45.         post $trial_coefficients ("`scope'") ("`model'") ("`term'") (`b') 
> (`se') (`p') (`b'-`critical'*`se') (`b'+`critical'*`se')
 46.     }
 47.     if `margin' == 1 {
 48.         quietly summarize p if `used', detail
 49.         local points "`r(p5)' `r(p25)' `r(p50)' `r(p75)' `r(p95)'"
 50.         foreach point of local points {
 51.             quietly lincom g + `point'*c.g#c.p
 52.             post $trial_margins ("`scope'") ("`model'") ("fund_slope") (`p
> oint') (.) (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
 53.         }
 54.     }
 55.     if `margin' == 2 {
 56.         quietly summarize d if `used', detail
 57.         local dpoints "`r(p25)' `r(p50)' `r(p75)'"
 58.         foreach point of local dpoints {
 59.             quietly lincom c.g#c.p + `point'*c.g#c.p#c.d
 60.             post $trial_margins ("`scope'") ("`model'") ("fiscal_moderatio
> n") (.) (`point') (r(estimate)) (r(se)) (r(p)) (r(lb)) (r(ub))
 61.         }
 62.     }
 63.     preserve
 64.     keep if `used'
 65.     keep city city_id year sample inv_count known_count early_share p d g 
> l_gdp l_secondary y1 y2 grant1
 66.     export delimited using "$trial_out/samples/`scope'_`model'.csv", repla
> ce
 67.     restore
 68. end

. 
