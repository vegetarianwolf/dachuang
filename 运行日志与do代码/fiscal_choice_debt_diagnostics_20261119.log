. quietly regress follow2 `interaction' pre2_round if common, vce(cluster sourc
> e_id)

. foreach q in 25 50 75 {
  2.     local offset = `q`q'' - `center'
  3.     quietly lincom 10*(p + `offset'*p_debt)
  4.     post `marginal' ("p`q'") (`q`q'') (r(estimate)) (r(se)) (r(lb)) (r(ub)
> )
  5. }

. postclose `marginal'

. 
. quietly regress p_debt `base' debt_c pre2_round if common

. predict double residual_interaction if e(sample), residuals
(225 missing values generated)

. generate double residual_sq = residual_interaction^2
(225 missing values generated)

. quietly summarize residual_sq if common, meanonly

. local total = r(sum)

. quietly levelsof source_id if common, local(cities)

. postfile `leaveout' int source_id str50 source_city double partial_variation_
> share b se p_value ci_lo ci_hi n clusters using `influence', replace
(file /var/folders/vg/d131wddn7t1g02rrshk6lhh00000gn/T//St77039.000003 not
    found)

. foreach city of local cities {
  2.     quietly levelsof source_city if source_id == `city', local(name) clean
  3.     quietly summarize residual_sq if common & source_id == `city', meanonl
> y
  4.     local share = r(sum)/`total'
  5.     quietly regress follow2 `interaction' pre2_round if common & source_id
>  != `city', vce(cluster source_id)
  6.     quietly lincom p_debt
  7.     post `leaveout' (`city') ("`name'") (`share') (r(estimate)) (r(se)) (r
> (p)) (r(lb)) (r(ub)) (e(N)) (e(N_clust))
  8. }

. postclose `leaveout'

