. global r2res `results'

. global r2coef `coefficients'

. 
. capture program drop est

. program define est
  1.     syntax, group(string) model(string) y(name) rhs(string) target(name) f
> lag(name) [absorb(name)]
  2.     tempvar tag unit_tag used
  3.     quietly count if `flag'
  4.     local n=r(N)
  5.     quietly egen `tag'=tag(source_id) if `flag'
  6.     quietly count if `tag'==1
  7.     local clusters=r(N)
  8.     quietly egen `unit_tag'=tag(unit_id) if `flag'
  9.     quietly count if `unit_tag'==1
 10.     local units=r(N)
 11.     if `n'<40 | `clusters'<20 {
 12.         post $r2res ("`group'") ("`model'") ("`y'") ("`target'") ("insuffi
> cient_sample") (.) (.) (.) (.) (.) (`n') (`clusters') (`units') (.) (.) (.)
 13.         exit
 14.     }
 15.     display "ROUND2 `model' `y' `rhs'"
 16.     if "`absorb'"!="" {
 17.         capture noisily areg `y' `rhs' if `flag', absorb(`absorb') vce(clu
> ster source_id)
 18.     }
 19.     else {
 20.         capture noisily regress `y' `rhs' if `flag', vce(cluster source_id
> )
 21.     }
 22.     local rc=_rc
 23.     if `rc'!=0 {
 24.         post $r2res ("`group'") ("`model'") ("`y'") ("`target'") ("stata_e
> rror_`rc'") (.) (.) (.) (.) (.) (`n') (`clusters') (`units') (.) (.) (.)
 25.         exit
 26.     }
 27.     generate byte `used'=e(sample)
 28.     quietly summarize year if `used', meanonly
 29.     local ymin=r(min)
 30.     local ymax=r(max)
 31.     local b=_b[`target']
 32.     local se=_se[`target']
 33.     local p=cond(`se'>0, 2*ttail(e(df_r),abs(`b'/`se')),.)
 34.     local critical=invttail(e(df_r),.025)
 35.     local status "ok"
 36.     if `se'==0 local status "target_omitted"
 37.     post $r2res ("`group'") ("`model'") ("`y'") ("`target'") ("`status'") 
> (`b') (`se') (`p') (`b'-`critical'*`se') (`b'+`critical'*`se') (e(N)) (`clust
> ers') (`units') (`ymin') (`ymax') (e(r2))
 38.     local terms : colnames e(b)
 39.     foreach term of local terms {
 40.         local b=_b[`term']
 41.         local se=_se[`term']
 42.         local p=cond(`se'>0,2*ttail(e(df_r),abs(`b'/`se')),.)
 43.         post $r2coef ("`group'") ("`model'") ("`term'") (`b') (`se') (`p')
>  (`b'-`critical'*`se') (`b'+`critical'*`se')
 44.     }
 45.     preserve
 46.     keep if `used'
 47.     keep obs_id unit_id unit_name source_city source_id year `y' p l_gdp l
> _secondary
 48.     export delimited using "$r2out/samples/`model'.csv", replace
 49.     restore
 50. end

